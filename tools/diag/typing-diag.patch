+      var cursor = await terminal!.CoreWebView2.ExecuteScriptAsync("JSON.stringify(window.__tdCursor ? window.__tdCursor() : null)");
+      TdTiming.Log($"[{draft.Title}] SCREEN {label}: {string.Join(" / ", lines)} cursor={cursor}");
